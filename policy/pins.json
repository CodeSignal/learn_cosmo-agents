{
  "agents": {
    "opencosmo": "opencode",
    "cosmodex": "codex",
    "cosmo-code": "claude"
  },
  "engines": {
    "opencode": {
      "package": "opencode-ai",
      "version": "1.18.35",
      "bin": "opencode",
      "default": "anthropic/claude-sonnet-5-5",
      "models": [
        "anthropic/claude-sonnet-5-5",
        "anthropic/claude-haiku-5-5",
        "openai/gpt-5.6-terra",
        "openai/gpt-6.1-sol",
        "openai/gpt-6-luna"
      ],
      "efforts": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "definitions": {
        "anthropic/claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "family": "claude-haiku",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "cost": {
            "input": 0.1,
            "output": 0.5
          }
        }
      }
    },
    "codex": {
      "package": "@openai/codex",
      "version": "0.161.0",
      "bin": "codex",
      "default": "gpt-5.6-terra",
      "models": [
        "gpt-5.6-terra",
        "gpt-6.1-sol",
        "gpt-6-luna"
      ],
      "efforts": [
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "claude": {
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.293",
      "bin": "claude",
      "default": "claude-sonnet-5-5",
      "models": [
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    }
  }
}
